
```{=html}
<% for (const item of items) { %>
  <%
    // Quarto doesn't anchor headings a template emits, so derive an id from the
    // category name. That's what in-page links like the "Supporting Packages"
    // button target.
    const anchor = item.category.toLowerCase()
      .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  %>

  <h2 id="<%- anchor %>"><%- item.category %></h2>

  <% if (item.intro) { %>
    <p class="category-intro"><%= item.intro %></p>
  <% } %>

  <div class="list grid" style="column-gap: 20px;">

    <% for (const tile of (item.tiles || [])) { %>
      <%
        const pending = tile.thumbnail === "placeholder.svg";
        const alt = tile.alt
          || (pending ? "Screenshot pending for " + tile.title
                      : "Screenshot of " + tile.title);
        // Screenshots are cropped to the tile (`cover`); diagrams and the
        // placeholder are shown whole (`contain`), since cropping a diagram
        // cuts its labels off mid-sentence; package hex logos get their own
        // mode (`hex`), which centres them on a tint at a size that reads as
        // branding rather than as a small picture in a big empty box.
        const fit = tile.fit || (pending ? "contain" : "cover");
        // `links` is optional and may be absent entirely -- a tile with nowhere
        // to point renders no footer rather than a dead button.
        //
        // The "View app" button is derived, and never written in apps.yml. A
        // deployed application serves at a name made from its directory in
        // apps/, so the address is a function of `app` and cannot drift from
        // the deployment. `content_id` is what says the application is
        // published: a tile with code but no content id has no address yet.
        const deployed = tile.app && tile.content_id;
        const links = [
          ...(deployed
            ? [{ text: "View app",
                 url: `https://posit-${tile.app}.share.connect.posit.cloud/` }]
            : []),
          ...(tile.links || []),
        ];
      %>
      <div class="card border g-col-12 g-col-md-6 g-col-lg-4 mb-4">
        <div class="card-img-top border-bottom">
          <div class="rounded-0">
            <img src="thumbnails/<%- tile.thumbnail %>" alt="<%- alt %>"
                 class="card-img-top gallery-entry__img gallery-entry__img--<%- fit %> rounded-0" />
          </div>
        </div>
        <div class="card-body">
          <h3 class="mt-3 mb-2"><%= tile.title %></h3>
          <div class="text-uppercase font-monospace"><%= tile.org %></div>
          <div class="text-muted"><p>
```
