          </p></div>
          <% if (tile.tech) { %>
            <div class="tech"><%= tile.tech %></div>
          <% } %>
        </div>

        <% if (links.length) { %>
          <div class="card-footer">
            <div class="view-app">
              <% for (const link of links) { %>
                <a href="<%- link.url %>" target="_blank"
                   class="btn btn-outline-primary btn-sm mb-1"><%= link.text %></a>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
<% } %>
