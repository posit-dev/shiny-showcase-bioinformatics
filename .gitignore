/.quarto/
**/*.quarto_ipynb
_site/
__pycache__/

# Runtime output of a vendored application. Operating an application locally
# writes these files, and they must not become part of the repository. Each
# application also excludes them from its deployment, in data/.rscignore.
apps/*/data/cache/

# Posit Publisher writes this directory next to an application. It records the
# server URL, the content GUID and the dashboard URL of a deployment. This
# repository must never publish that information, so git ignores the directory
# at every level.
.posit/

# rsconnect writes the same kind of record: one .dcf file per deployment, with
# the server, the account and the content id. `deployApp()` writes it on your
# machine and on the runner. deploy-apps.yml holds the ids that the deployment
# needs, so this directory is output, and git ignores it.
rsconnect/

# thumbnails/src/build_thumbs.py writes one artboard per application, and
# render_boards.R reads them. They are build output: the script is the source.
thumbnails/src/*.dc.html
thumbnails/src/canvas.json

# render_boards.R writes the slide size, SCALE=2, beside the gallery files as
# thumbnails/<app>-4800.png. The slides repository keeps those; this one does not.
thumbnails/*-4800.png

# macOS writes this file into any directory that the Finder opens.
.DS_Store
